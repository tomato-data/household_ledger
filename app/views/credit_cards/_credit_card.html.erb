<%= turbo_frame_tag credit_card do %>
  <div class="card p-4" data-controller="inline-edit">
    <%# 표시 모드 %>
    <div data-inline-edit-target="display">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-lg flex items-center justify-center"
               style="background-color: var(--color-accent-bg); color: var(--color-accent);">
            <%= lucide_icon("credit-card", size: 18) %>
          </div>
          <div>
            <span class="text-sm font-bold"><%= credit_card.name %></span>
            <% if credit_card.is_default %>
              <span class="badge badge-accent ml-1 text-[10px]">기본</span>
            <% end %>
          </div>
        </div>
        <span class="badge badge-accent">매월 <%= credit_card.payment_day %>일</span>
      </div>

      <%# 액션 %>
      <div class="flex items-center gap-2 mt-3">
        <% unless credit_card.is_default %>
          <%= button_to credit_card_path(credit_card),
              method: :patch,
              params: { credit_card: { is_default: true } },
              class: "btn btn-ghost text-xs cursor-pointer" do %>
            <%= lucide_icon("star", size: 12) %>
            <span>기본 카드로 설정</span>
          <% end %>
        <% end %>
        <button data-action="inline-edit#edit"
                class="btn btn-ghost text-xs cursor-pointer">
          <%= lucide_icon("pencil", size: 12) %>
          <span>수정</span>
        </button>
        <%= button_to credit_card_path(credit_card),
            method: :delete,
            class: "btn btn-ghost text-xs cursor-pointer",
            style: "color: var(--color-danger);",
            form: { data: { turbo_confirm: "이 카드를 삭제하시겠습니까?" } } do %>
          <%= lucide_icon("trash-2", size: 12) %>
          <span>삭제</span>
        <% end %>
      </div>
    </div>

    <%# 편집 모드 %>
    <div data-inline-edit-target="editor" class="hidden">
      <%= form_with(model: credit_card, class: "space-y-3") do |f| %>
        <div class="flex items-center gap-3">
          <%= f.text_field :name, class: "input flex-1 text-sm" %>
          <%= f.select :payment_day,
              (1..28).map { |d| ["#{d}일", d] },
              {},
              class: "input w-20 text-sm text-center" %>
        </div>
        <div class="flex items-center gap-2">
          <%= f.submit "저장", class: "btn btn-primary text-xs" %>
          <button type="button" data-action="inline-edit#cancel" class="btn btn-ghost text-xs">취소</button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
