<%= turbo_frame_tag subcategory do %>
  <div class="flex items-center gap-2 py-1.5 px-2 rounded-md group/sub"
       data-controller="inline-edit">

    <%# 들여쓰기 표시 %>
    <span class="text-[10px] flex-shrink-0" style="color: var(--color-border);">└</span>

    <%# 색상 표시 + 아이콘 %>
    <div class="w-5 h-5 rounded flex items-center justify-center flex-shrink-0"
         style="background-color: <%= subcategory.color || '#a3a3a3' %>20; color: <%= subcategory.color || '#a3a3a3' %>;">
      <%= lucide_icon(subcategory.icon, size: 11) %>
    </div>

    <%# 이름 (표시) %>
    <span data-inline-edit-target="display" class="text-xs font-medium flex-1 min-w-0 truncate"><%= subcategory.name %></span>

    <%# 이름 + 색상 (편집) %>
    <div data-inline-edit-target="editor" class="flex-1 hidden">
      <%= form_with(model: subcategory, class: "flex items-center gap-1.5") do |f| %>
        <%# 색상 선택 (컴팩트 도트) %>
        <div class="flex items-center gap-1 flex-shrink-0">
          <% %w[#a3a3a3 #f43f5e #8b5cf6 #06b6d4 #f59e0b #10b981 #ec4899 #f97316].each do |color| %>
            <label class="cursor-pointer">
              <input type="radio" name="category[color]" value="<%= color %>"
                     <%= "checked" if subcategory.color == color %>
                     class="hidden peer">
              <div class="w-3.5 h-3.5 rounded-full transition-all hover:scale-125 peer-checked:ring-1 peer-checked:ring-offset-1"
                   style="background-color: <%= color %>; --tw-ring-color: <%= color %>;"></div>
            </label>
          <% end %>
        </div>
        <%= f.text_field :name, class: "input flex-1 min-w-0 text-xs py-0.5" %>
        <%= f.submit "저장", class: "btn btn-primary text-[10px] py-0.5 px-2" %>
        <button type="button" data-action="inline-edit#cancel" class="btn btn-ghost text-[10px] py-0.5 px-1.5">취소</button>
      <% end %>
    </div>

    <%# 액션 %>
    <div class="flex items-center gap-0.5 opacity-0 group-hover/sub:opacity-100 transition-opacity flex-shrink-0"
         data-inline-edit-target="actions">
      <button data-action="inline-edit#edit"
              class="btn-ghost p-0.5 rounded cursor-pointer" style="color: var(--color-text-muted);" aria-label="수정">
        <%= lucide_icon("pencil", size: 11) %>
      </button>
      <%= button_to category_path(subcategory),
          method: :delete,
          class: "btn-ghost p-0.5 rounded cursor-pointer",
          style: "color: var(--color-danger);",
          aria_label: "삭제",
          form: { data: { turbo_confirm: "이 하위 카테고리를 삭제하시겠습니까?" } } do %>
        <%= lucide_icon("trash-2", size: 11) %>
      <% end %>
    </div>
  </div>
<% end %>
