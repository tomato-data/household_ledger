<%# 아이콘 + 컬러 피커 드롭다운 %>
<div data-icon-picker-target="dropdown" class="hidden absolute left-0 top-12 z-50 card-elevated w-[280px]">

  <%# 컬러 선택 %>
  <div data-icon-picker-target="colorDots" class="flex items-center justify-center gap-1.5 px-3 pt-3 pb-2">
    <% %w[#a3a3a3 #a8856c #f97316 #eab308 #22c55e #06b6d4 #3b82f6 #8b5cf6 #ec4899 #ef4444].each do |color| %>
      <button type="button"
              data-action="icon-picker#selectColor"
              data-color="<%= color %>"
              class="w-5 h-5 rounded-full transition-all hover:scale-110 <%= 'ring-2' if (current_color || '#a3a3a3') == color %>"
              style="background-color: <%= color %>; --tw-ring-color: var(--color-text-primary); ring-offset: 2px;">
      </button>
    <% end %>
  </div>

  <div style="border-bottom: 1px solid var(--color-border-subtle);"></div>

  <%# 검색 %>
  <div class="p-2">
    <input type="text" data-icon-picker-target="search" data-action="input->icon-picker#filter"
           placeholder="아이콘 검색..."
           class="input text-sm py-1.5">
  </div>

  <%# 아이콘 그리드 (JS가 동적으로 채움) %>
  <div data-icon-picker-target="grid" class="grid grid-cols-7 gap-0.5 p-2 max-h-[200px] overflow-y-auto">
  </div>
</div>
