<div class="space-y-6 py-4">
  <h1 class="text-xl font-bold">카테고리 관리</h1>

  <%# 새 상위 카테고리 추가 폼 %>
  <div class="card p-4">
    <h2 class="text-xs font-medium mb-3" style="color: var(--color-text-muted);">상위 카테고리 추가</h2>
    <%= render "categories/form", category: Category.new %>
  </div>

  <%# 카테고리 목록 (드래그앤드롭) %>
  <div class="card p-4"
       data-controller="sortable"
       data-sortable-url-value="<%= reorder_categories_path %>">

    <div data-sortable-target="list" class="space-y-1" id="categories_list">
      <% @categories.each do |category| %>
        <%= render "categories/category", category: category %>
      <% end %>
    </div>

    <% if @categories.empty? %>
      <%= render "shared/empty_state", message: "카테고리가 없습니다" %>
    <% end %>
  </div>
</div>
