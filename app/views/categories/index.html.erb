<div class="space-y-6 py-4">
  <h1 class="text-xl font-bold">카테고리 / 태그 관리</h1>

  <%# 탭 네비게이션 %>
  <div class="flex gap-1 p-1 rounded-lg" style="background-color: var(--color-bg-tertiary);">
    <%= link_to categories_path,
        class: "flex-1 text-center py-2 rounded-md text-sm font-medium transition-all",
        style: "background-color: var(--color-bg-secondary); color: var(--color-text-primary); box-shadow: var(--shadow-sm);" do %>
      <%= lucide_icon("folder-open", size: 14) %> 카테고리
    <% end %>
    <%= link_to tags_path,
        class: "flex-1 text-center py-2 rounded-md text-sm font-medium transition-all",
        style: "color: var(--color-text-muted);" do %>
      <%= lucide_icon("tag", size: 14) %> 태그
    <% end %>
  </div>

  <%# 새 상위 카테고리 추가 폼 %>
  <div class="card p-4">
    <h2 class="text-xs font-medium mb-3" style="color: var(--color-text-muted);">상위 카테고리 추가</h2>
    <%= render "categories/form", category: Category.new %>
  </div>

  <%# 카테고리 목록 (드래그앤드롭) %>
  <div class="card p-4"
       data-controller="sortable"
       data-sortable-url-value="<%= reorder_categories_path %>">

    <div data-sortable-target="list" class="space-y-1" id="categories_list">
      <% @categories.each do |category| %>
        <%= render "categories/category", category: category %>
      <% end %>
    </div>

    <% if @categories.empty? %>
      <%= render "shared/empty_state", message: "카테고리가 없습니다" %>
    <% end %>
  </div>
</div>
