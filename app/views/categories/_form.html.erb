<%= form_with(model: category, class: "flex items-center gap-3") do |f| %>
  <div class="w-12">
    <%= f.text_field :emoji,
        class: "w-full text-center text-xl px-2 py-1.5 rounded-lg",
        style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border);",
        placeholder: "😀",
        maxlength: 2 %>
  </div>

  <div class="flex-1">
    <%= f.text_field :name,
        class: "w-full px-3 py-1.5 rounded-lg text-sm",
        style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); color: var(--color-text-primary);",
        placeholder: "카테고리 이름" %>
  </div>

  <%= f.submit category.persisted? ? "수정" : "추가",
      class: "px-4 py-1.5 rounded-lg text-sm font-medium cursor-pointer transition-colors",
      style: "background-color: var(--color-accent); color: var(--color-text-primary);" %>
<% end %>
