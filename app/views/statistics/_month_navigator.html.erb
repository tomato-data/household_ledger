<div class="flex items-center justify-between">
  <%= link_to statistics_path(date: date.prev_month.strftime("%Y-%m-%d"), type: @type),
      class: "btn-ghost p-2 rounded-lg",
      data: { turbo_frame: "stats_frame" } do %>
    <i data-lucide="chevron-left" class="lucide-icon" style="width: 18px; height: 18px;"></i>
  <% end %>

  <span class="text-base font-bold">
    <%= l(date, format: "%Y년 %m월") %>
  </span>

  <%= link_to statistics_path(date: date.next_month.strftime("%Y-%m-%d"), type: @type),
      class: "btn-ghost p-2 rounded-lg",
      data: { turbo_frame: "stats_frame" } do %>
    <i data-lucide="chevron-right" class="lucide-icon" style="width: 18px; height: 18px;"></i>
  <% end %>
</div>
