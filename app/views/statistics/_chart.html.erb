<div class="card p-4">
  <% if category_stats.any? %>
    <div class="flex justify-center">
      <%= pie_chart category_stats.map { |s| [s[:name], s[:amount]] },
          donut: true,
          colors: ["#2dd4bf", "#fb7185", "#fbbf24", "#818cf8", "#34d399", "#f97316", "#06b6d4", "#ec4899", "#84cc16", "#a78bfa", "#fb923c", "#14b8a6", "#e879f9"],
          library: {
            plugins: {
              legend: { display: false }
            },
            cutout: "65%"
          } %>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "해당 기간의 데이터가 없습니다" %>
  <% end %>
</div>
