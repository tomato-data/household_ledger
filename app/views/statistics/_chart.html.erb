<div class="rounded-xl p-4" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">
  <% if category_stats.any? %>
    <div class="flex justify-center">
      <%= pie_chart category_stats.map { |s| [s[:name], s[:amount]] },
          donut: true,
          colors: ["#22d3ee", "#fb7185", "#f59e0b", "#8b5cf6", "#4ade80", "#f97316", "#06b6d4", "#ec4899", "#84cc16", "#a78bfa", "#fb923c", "#14b8a6", "#e879f9"],
          library: {
            plugins: {
              legend: { display: false }
            },
            cutout: "60%"
          } %>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "해당 기간의 데이터가 없습니다" %>
  <% end %>
</div>
