<div class="fixed top-16 lg:top-4 lg:right-4 lg:left-auto left-1/2 lg:translate-x-0 -translate-x-1/2 z-50 w-full max-w-sm px-4 space-y-2"
     aria-live="polite" role="status">
  <% flash.each do |type, message| %>
    <div data-controller="flash"
         class="card-elevated px-4 py-3 text-sm font-medium transition-opacity duration-300"
         style="color: <%= type == 'notice' ? 'var(--color-success)' : 'var(--color-danger)' %>;">
      <div class="flex items-center justify-between">
        <span><%= message %></span>
        <button data-action="flash#dismiss" class="ml-3 opacity-60 hover:opacity-100" aria-label="닫기">&times;</button>
      </div>
    </div>
  <% end %>
</div>
