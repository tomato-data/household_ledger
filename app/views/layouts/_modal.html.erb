<%# 모달 래퍼 — new/edit 뷰에서 render "layouts/modal" 로 사용 %>
<div data-controller="modal"
     data-action="keydown.esc->modal#close click->modal#closeOnBackdrop"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 modal-overlay"
     role="dialog"
     aria-modal="true"
     style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px);">
  <div data-modal-target="content"
       class="card-elevated w-full max-w-md lg:max-w-2xl max-h-[90vh] overflow-y-auto p-6 modal-content"
       style="overscroll-behavior: contain;">
    <%= yield %>
  </div>
</div>
