<%# 모바일 전용 상단 네비바 (lg 이상에서는 숨김) %>
<nav class="fixed top-0 left-0 right-0 z-50 h-14 flex items-center justify-between px-4 lg:hidden"
     style="background-color: var(--color-bg-secondary); border-bottom: 1px solid var(--color-border-subtle); box-shadow: var(--shadow-sm);">

  <% if user_signed_in? %>
    <button data-action="sidebar#toggle" class="btn-ghost p-2 rounded-lg" aria-label="메뉴">
      <i data-lucide="menu" aria-hidden="true" class="lucide-icon" style="width: 20px; height: 20px;"></i>
    </button>
  <% else %>
    <div></div>
  <% end %>

  <span class="text-base font-bold tracking-tight">가계부</span>

  <div class="flex items-center gap-2">
    <button data-action="theme#toggle" class="btn-ghost p-2 rounded-lg" aria-label="테마 변경">
      <i data-lucide="moon" data-theme-target="icon" aria-hidden="true" class="lucide-icon" style="width: 18px; height: 18px;"></i>
    </button>

    <% unless user_signed_in? %>
      <%= link_to "로그인", new_user_session_path, class: "text-sm font-medium" %>
    <% end %>
  </div>
</nav>
