<%# ===== 데스크톱 고정 사이드바 (lg 이상에서만 표시) ===== %>
<aside class="hidden lg:flex lg:flex-col lg:fixed lg:inset-y-0 lg:left-0 lg:w-60 lg:z-40"
       style="background-color: var(--color-bg-secondary); border-right: 1px solid var(--color-border-subtle);">

  <%# 로고 / 앱 이름 %>
  <div class="h-16 flex items-center px-5" style="border-bottom: 1px solid var(--color-border-subtle);">
    <span class="text-lg font-bold tracking-tight">가계부</span>
  </div>

  <%# 네비게이션 링크 %>
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <%= sidebar_link "홈", authenticated_root_path, "home" %>
    <%= sidebar_link "통계", statistics_path, "bar-chart-3" %>
    <%= sidebar_link "카테고리/태그", categories_path, "folder-open", also_active_for: [tags_path] %>
    <%= sidebar_link "반복 거래", recurring_transactions_path, "repeat" %>
    <%= sidebar_link "자산 보정", asset_adjustments_path, "scale" %>
    <%= sidebar_link "신용카드", credit_cards_path, "credit-card" %>
  </nav>

  <%# 하단 영역: 테마 토글 + 유저 정보 + 로그아웃 %>
  <div class="px-3 py-4 space-y-2" style="border-top: 1px solid var(--color-border-subtle);">
    <%# 테마 토글 %>
    <button data-action="theme#toggle"
            class="sidebar-link w-full text-left">
      <i data-lucide="moon" data-theme-target="icon" class="lucide-icon" style="width: 18px; height: 18px;"></i>
      <span>테마 변경</span>
    </button>

    <%# 유저 정보 %>
    <div class="px-3 py-2">
      <p class="text-xs truncate" style="color: var(--color-text-muted);"><%= current_user.email %></p>
    </div>

    <%# 로그아웃 %>
    <%= link_to destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "sidebar-link",
        style: "color: var(--color-danger);" do %>
      <%= lucide_icon("log-out", size: 18) %>
      <span>로그아웃</span>
    <% end %>
  </div>
</aside>

<%# ===== 모바일 슬라이드 사이드바 (lg 미만, 햄버거 메뉴로 열림) ===== %>
<div data-sidebar-target="overlay"
     data-action="click->sidebar#close"
     class="fixed inset-0 bg-black/50 z-50 hidden lg:hidden"></div>

<aside data-sidebar-target="panel"
       class="fixed top-0 left-0 h-full w-64 z-50 transform -translate-x-full transition-transform duration-300 lg:hidden"
       style="background-color: var(--color-bg-secondary);">

  <div class="p-4 flex items-center justify-between" style="border-bottom: 1px solid var(--color-border-subtle);">
    <span class="font-bold text-lg">가계부</span>
    <button data-action="sidebar#close" class="btn-ghost p-1.5 rounded-lg" aria-label="닫기">
      <i data-lucide="x" class="lucide-icon" style="width: 18px; height: 18px;"></i>
    </button>
  </div>

  <nav class="px-3 py-4 space-y-1">
    <%= sidebar_link "홈", authenticated_root_path, "home" %>
    <%= sidebar_link "통계", statistics_path, "bar-chart-3" %>
    <%= sidebar_link "카테고리/태그", categories_path, "folder-open", also_active_for: [tags_path] %>
    <%= sidebar_link "반복 거래", recurring_transactions_path, "repeat" %>
    <%= sidebar_link "자산 보정", asset_adjustments_path, "scale" %>
    <%= sidebar_link "신용카드", credit_cards_path, "credit-card" %>
  </nav>

  <div class="absolute bottom-0 left-0 right-0 px-3 py-4" style="border-top: 1px solid var(--color-border-subtle);">
    <div class="px-3 py-2 mb-1">
      <p class="text-xs truncate" style="color: var(--color-text-muted);"><%= current_user.email %></p>
    </div>
    <%= link_to destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "sidebar-link",
        style: "color: var(--color-danger);" do %>
      <%= lucide_icon("log-out", size: 18) %>
      <span>로그아웃</span>
    <% end %>
  </div>
</aside>
