<%# 사이드바 배경 오버레이 %>
<div data-sidebar-target="overlay"
     data-action="click->sidebar#close"
     class="fixed inset-0 bg-black/50 z-50 hidden"></div>

<%# 사이드바 패널 %>
<aside data-sidebar-target="panel"
       class="fixed top-0 left-0 h-full w-64 z-50 transform -translate-x-full transition-transform duration-300"
       style="background-color: var(--color-bg-secondary);">

  <div class="p-4" style="border-bottom: 1px solid var(--color-border);">
    <div class="flex items-center justify-between">
      <span class="font-bold text-lg">메뉴</span>
      <button data-action="sidebar#close" class="p-1 rounded hover:opacity-80" aria-label="닫기">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <% if user_signed_in? %>
      <p class="text-sm mt-2" style="color: var(--color-text-secondary);"><%= current_user.email %></p>
    <% end %>
  </div>

  <nav class="p-4 space-y-1">
    <%= link_to authenticated_root_path,
        class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors hover:opacity-80",
        style: "background-color: var(--color-bg-tertiary);" do %>
      <%= lucide_icon("home", size: 18) %><span>홈</span>
    <% end %>

    <%= link_to statistics_path,
        class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors hover:opacity-80" do %>
      <%= lucide_icon("bar-chart-3", size: 18) %><span>통계</span>
    <% end %>

    <%= link_to categories_path,
        class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors hover:opacity-80" do %>
      <%= lucide_icon("folder-open", size: 18) %><span>카테고리 관리</span>
    <% end %>

    <%= link_to recurring_transactions_path,
        class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors hover:opacity-80" do %>
      <%= lucide_icon("repeat", size: 18) %><span>반복 거래</span>
    <% end %>

    <%= link_to asset_adjustments_path,
        class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors hover:opacity-80" do %>
      <%= lucide_icon("scale", size: 18) %><span>자산 보정</span>
    <% end %>
  </nav>

  <div class="absolute bottom-0 left-0 right-0 p-4" style="border-top: 1px solid var(--color-border);">
    <%= link_to destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "flex items-center gap-3 px-3 py-2 rounded-lg transition-colors hover:opacity-80",
        style: "color: var(--color-danger);" do %>
      <%= lucide_icon("log-out", size: 18) %><span>로그아웃</span>
    <% end %>
  </div>
</aside>
