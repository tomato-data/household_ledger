<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "가계부" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="가계부">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full min-h-screen"
        style="background-color: var(--color-bg-primary); color: var(--color-text-primary);"
        data-controller="sidebar">

    <%= render "layouts/navbar" %>
    <%= render "layouts/sidebar" %>
    <%= render "layouts/flash" %>

    <main class="min-h-screen pt-14 pb-20 px-4 max-w-lg mx-auto">
      <%= yield %>
    </main>

    <turbo-frame id="modal"></turbo-frame>

    <% if user_signed_in? %>
      <%= link_to new_transaction_path,
          class: "fixed bottom-6 right-6 w-14 h-14 rounded-full flex items-center justify-center text-2xl shadow-lg z-40 transition-colors",
          style: "background-color: var(--color-accent); color: var(--color-text-primary);",
          data: { turbo_frame: "modal" } do %>
        +
      <% end %>
    <% end %>
  </body>
</html>
