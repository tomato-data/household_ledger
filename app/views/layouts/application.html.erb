<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Household Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Household Ledger">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# ===== 1. 네비게이션 바 ===== %>
    <nav>
      <% if user_signed_in? %>
        <%= current_user.email %>
        <%# CSS 추가 예정 %>
        <%= link_to "로그아웃", destroy_user_session_path, data: { turbo_method: :delete} %>
      <% else %>
        <%# 비로그인 상태: 로그인 + 회원가입 링크%>
        <%= link_to "로그인", new_user_session_path %>
        <%= link_to "회원가입", new_user_registration_path %>
      <% end %>
    </nav>

    <%# ===== 2. Flash 메시지 ===== %>
    <% flash.each do |type, message| %>
      <p class="<%= type == 'notice' ? 'text-green-600' : 'text-red-600' %>">
        <%= message %>
      </p>
    <% end %>

    <%# ===== 3. 메인 콘텐츠 ===== %>
    <main class="container mx-auto mt-28 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
