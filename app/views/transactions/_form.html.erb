<%= form_with(model: transaction, data: { controller: "transaction-form amount-input" }) do |f| %>

  <% if transaction.errors.any? %>
    <div class="mb-4 p-3 rounded-lg text-sm" style="background-color: var(--color-expense-bg); color: var(--color-danger);">
      <% transaction.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <%# 수입/지출 토글 %>
  <div class="flex gap-2 mb-4">
    <label class="flex-1">
      <input type="radio" name="transaction[transaction_type]" value="income"
             data-action="transaction-form#selectType"
             data-transaction-form-target="typeRadio"
             <%= "checked" if transaction.transaction_type == "income" %>
             class="hidden peer">
      <div class="text-center py-2 rounded-lg cursor-pointer text-sm font-medium transition-all peer-checked:font-bold"
           data-transaction-form-target="incomeButton"
           style="border: 1px solid var(--color-border);">
        수입
      </div>
    </label>
    <label class="flex-1">
      <input type="radio" name="transaction[transaction_type]" value="expense"
             data-action="transaction-form#selectType"
             data-transaction-form-target="typeRadio"
             <%= "checked" if transaction.transaction_type == "expense" || transaction.new_record? %>
             class="hidden peer">
      <div class="text-center py-2 rounded-lg cursor-pointer text-sm font-medium transition-all peer-checked:font-bold"
           data-transaction-form-target="expenseButton"
           style="border: 1px solid var(--color-border);">
        지출
      </div>
    </label>
  </div>

  <%# 상태 토글 (카드 결제 시 자동으로 예정) %>
  <div class="flex gap-2 mb-4" data-transaction-form-target="statusSection">
    <label class="flex-1">
      <input type="radio" name="transaction[status]" value="confirmed"
             data-action="transaction-form#selectStatus"
             <%= "checked" if transaction.status == "confirmed" || transaction.new_record? %>
             class="hidden peer">
      <div class="text-center py-1.5 rounded-lg cursor-pointer text-sm transition-all"
           data-transaction-form-target="confirmedButton"
           style="border: 1px solid var(--color-border);">
        확정
      </div>
    </label>
    <label class="flex-1">
      <input type="radio" name="transaction[status]" value="scheduled"
             data-action="transaction-form#selectStatus"
             <%= "checked" if transaction.status == "scheduled" %>
             class="hidden peer">
      <div class="text-center py-1.5 rounded-lg cursor-pointer text-sm transition-all"
           data-transaction-form-target="scheduledButton"
           style="border: 1px solid var(--color-border);">
        예정
      </div>
    </label>
  </div>

  <%# === 카드 결제 섹션 === %>
  <% if defined?(credit_cards) && credit_cards&.any? %>
    <div class="mb-4 p-3 rounded-lg" style="border: 1px solid var(--color-border-subtle); background-color: var(--color-bg-tertiary);"
         data-controller="card-payment">
      <%# 카드 결제 토글 %>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="card_payment" value="1"
               data-action="card-payment#toggle"
               data-card-payment-target="toggle"
               class="rounded">
        <span class="text-sm font-medium flex items-center gap-1.5">
          <%= lucide_icon("credit-card", size: 14) %>
          카드 결제
        </span>
      </label>

      <%# 카드 선택 + 할부 (토글 시 표시) %>
      <div data-card-payment-target="details" class="hidden mt-3 space-y-2.5">
        <%# 카드 선택 %>
        <div class="flex items-center gap-2">
          <label class="text-xs font-medium flex-shrink-0" style="color: var(--color-text-muted);">카드</label>
          <% default_card = credit_cards.find(&:is_default) || credit_cards.first %>
          <select name="credit_card_id" class="input flex-1 text-sm py-1.5">
            <% credit_cards.each do |card| %>
              <option value="<%= card.id %>" <%= "selected" if card == default_card %>>
                <%= card.name %> (매월 <%= card.payment_day %>일)
              </option>
            <% end %>
          </select>
        </div>

        <%# 할부 %>
        <div class="flex items-center gap-2">
          <label class="text-xs font-medium flex-shrink-0" style="color: var(--color-text-muted);">할부</label>
          <select name="installment_count" class="input flex-1 text-sm py-1.5">
            <option value="1">일시불</option>
            <% (2..12).each do |n| %>
              <option value="<%= n %>"><%= n %>개월</option>
            <% end %>
          </select>
        </div>

        <p class="text-[10px]" style="color: var(--color-text-muted);">
          결제일에 자동으로 예정 거래가 생성됩니다
        </p>
      </div>
    </div>
  <% end %>

  <%# 금액 %>
  <div class="mb-4">
    <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">금액</label>
    <div class="flex items-center gap-2">
      <input type="text"
             data-amount-input-target="display"
             data-action="input->amount-input#format"
             value="<%= number_with_delimiter(transaction.amount) if transaction.amount %>"
             placeholder="0"
             class="input flex-1 text-right text-lg font-tabular"
             inputmode="numeric"
             autocomplete="off">
      <span class="text-sm font-medium" style="color: var(--color-text-muted);">원</span>
    </div>
    <%= f.hidden_field :amount, data: { amount_input_target: "value" } %>
  </div>

  <%# 설명 %>
  <div class="mb-4">
    <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">설명</label>
    <%= f.text_field :description, class: "input", placeholder: "내용을 입력하세요" %>
  </div>

  <%# 날짜 %>
  <div class="mb-4">
    <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">날짜</label>
    <%= f.date_field :date, value: transaction.date || Date.today, class: "input" %>
  </div>

  <%# 카테고리 선택 %>
  <div class="mb-6">
    <label class="block text-xs font-medium mb-2" style="color: var(--color-text-muted);">카테고리</label>
    <%= render "transactions/category_selector",
        categories: categories,
        selected_id: transaction.category_id %>
  </div>

  <%# 버튼 %>
  <div class="flex gap-3">
    <button type="button" data-action="modal#close" class="btn btn-ghost flex-1 py-2.5">
      취소
    </button>
    <%= f.submit transaction.persisted? ? "수정" : "저장",
        class: "btn btn-primary flex-1 py-2.5 font-bold" %>
  </div>
<% end %>
