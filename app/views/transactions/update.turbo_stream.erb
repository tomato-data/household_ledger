<%= turbo_stream.replace @transaction do %>
  <%= render partial: "transactions/transaction", locals: { transaction: @transaction } %>
<% end %>

<%= turbo_stream.replace "month_frame" do %>
  <turbo-frame id="month_frame">
    <div class="relative">
      <div class="lg:pr-[340px]">
        <div class="space-y-4">
          <%= render "dashboard/summary_cards",
              total_income: @total_income,
              total_expense: @total_expense,
              total_assets: @total_assets %>
          <%= render "dashboard/calendar",
              date: @date,
              transactions_by_date: @transactions_by_date,
              selected_date: @transaction.date %>
        </div>
      </div>
      <div class="hidden lg:block absolute top-0 right-0 w-[320px] h-full">
        <turbo-frame id="daily_transactions" class="block h-full">
          <%= render "dashboard/daily_transactions",
              selected_dates: @selected_dates || [@transaction.date],
              transactions: @daily_transactions || [],
              selection_income: @selection_income || 0,
              selection_expense: @selection_expense || 0 %>
        </turbo-frame>
      </div>
      <div class="lg:hidden mt-4">
        <turbo-frame id="daily_transactions_mobile">
          <%= render "dashboard/daily_transactions",
              selected_dates: @selected_dates || [@transaction.date],
              transactions: @daily_transactions || [],
              selection_income: @selection_income || 0,
              selection_expense: @selection_expense || 0 %>
        </turbo-frame>
      </div>
    </div>
  </turbo-frame>
<% end %>

<%= turbo_stream.replace "modal" do %>
  <turbo-frame id="modal"></turbo-frame>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <script>showToast("거래가 수정되었습니다")</script>
<% end %>
