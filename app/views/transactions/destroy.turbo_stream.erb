<%= turbo_stream.remove @transaction %>

<%= turbo_stream.replace "month_frame" do %>
  <turbo-frame id="month_frame">
    <%= render "dashboard/summary_cards",
        total_income: @total_income,
        total_expense: @total_expense,
        total_assets: @total_assets %>
    <%= render "dashboard/calendar",
        date: @date,
        transactions_by_date: @transactions_by_date,
        selected_date: @transaction.date %>
  </turbo-frame>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <script>showToast("거래가 삭제되었습니다")</script>
<% end %>
