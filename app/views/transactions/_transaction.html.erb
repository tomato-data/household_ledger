<%= turbo_frame_tag transaction do %>
  <div class="flex items-center justify-between py-2 px-3 rounded-lg transition-colors hover:opacity-90"
       style="background-color: var(--color-bg-tertiary);"
       id="<%= dom_id(transaction) %>">

    <div class="flex items-center gap-3 flex-1 min-w-0">
      <%# 카테고리 이모지 %>
      <span class="flex-shrink-0" style="color: <%= transaction.category&.color || '#a3a3a3' %>;">
        <%= lucide_icon(transaction.category&.icon || "file-text", size: 20) %>
      </span>

      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate"><%= transaction.description %></p>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="text-xs" style="color: var(--color-text-muted);">
            <%= transaction.category&.name %>
          </span>
          <% if transaction.status == "scheduled" %>
            <span class="text-xs">⏰</span>
          <% end %>
          <% if transaction.recurring_transaction.present? %>
            <span class="text-xs">🔄</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-3 flex-shrink-0">
      <span class="text-sm font-bold">
        <%= colored_amount(transaction.amount, transaction.transaction_type) %>
      </span>

      <div class="flex items-center gap-1">
        <%= link_to edit_transaction_path(transaction),
            class: "p-1 rounded hover:opacity-80",
            data: { turbo_frame: "modal" } do %>
          <svg class="w-4 h-4" style="color: var(--color-text-muted);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        <% end %>

        <%= button_to transaction_path(transaction),
            method: :delete,
            class: "p-1 rounded hover:opacity-80",
            style: "color: var(--color-danger);",
            form: { data: { turbo_confirm: "이 거래를 삭제하시겠습니까?" } } do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
