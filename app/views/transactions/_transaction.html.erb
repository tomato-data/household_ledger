<%= turbo_frame_tag transaction do %>
  <div class="py-2.5 px-4 transition-colors hover:bg-[var(--color-bg-tertiary)]"
       style="border-bottom: 1px solid var(--color-border-subtle);"
       id="<%= dom_id(transaction) %>">

    <%# 1행: 아이콘 + 설명 + 금액 %>
    <div class="flex items-center gap-2.5">
      <%# 카테고리 아이콘 %>
      <div class="w-7 h-7 rounded-md flex items-center justify-center flex-shrink-0"
           style="background-color: <%= transaction.category&.color || '#a3a3a3' %>20; color: <%= transaction.category&.color || '#a3a3a3' %>;">
        <%= lucide_icon(transaction.category&.icon || "file-text", size: 14) %>
      </div>

      <%# 설명 + 카테고리 %>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate"><%= transaction.description %></p>
        <div class="flex items-center gap-1.5">
          <span class="text-[10px]" style="color: var(--color-text-muted);">
            <%= transaction.category&.full_name %>
          </span>
          <% if transaction.card_payment? %>
            <%= lucide_icon("credit-card", size: 10, style: "color: var(--color-accent);") %>
            <span class="text-[9px]" style="color: var(--color-text-muted);">
              <%= transaction.credit_card&.name %>
              <% if transaction.purchase_date.present? %>
                · <%= l(transaction.purchase_date, format: "%m/%d") %> 사용
              <% end %>
            </span>
          <% end %>
          <% if transaction.installment? %>
            <span class="text-[9px] font-bold" style="color: var(--color-accent);"><%= transaction.installment_label %></span>
          <% end %>
          <% if transaction.status == "scheduled" && !transaction.card_payment? %>
            <%= lucide_icon("clock", size: 10, style: "color: var(--color-assets);") %>
          <% end %>
          <% if transaction.recurring_transaction.present? %>
            <%= lucide_icon("repeat", size: 10, style: "color: var(--color-accent);") %>
          <% end %>
          <% if transaction.tags.any? %>
            <% transaction.tags.each do |tag| %>
              <span class="inline-block w-1.5 h-1.5 rounded-full" style="background-color: <%= tag.color %>;" title="<%= tag.name %>"></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <%# 금액 + 액션 (오른쪽 정렬) %>
      <div class="flex items-center gap-1 flex-shrink-0">
        <span class="text-xs font-bold font-tabular">
          <%= colored_amount(transaction.amount, transaction.transaction_type) %>
        </span>

        <%= link_to edit_transaction_path(transaction),
            class: "btn-ghost p-1 rounded-md opacity-40 hover:opacity-100",
            data: { turbo_frame: "modal" },
            aria_label: "수정" do %>
          <%= lucide_icon("pencil", size: 12) %>
        <% end %>

        <%= button_to transaction_path(transaction),
            method: :delete,
            class: "btn-ghost p-1 rounded-md opacity-40 hover:opacity-100 cursor-pointer",
            style: "color: var(--color-danger);",
            aria_label: "삭제",
            form: { data: { turbo_confirm: transaction.installment_group.present? ? "이 할부 거래 전체(#{transaction.installment_count}건)를 삭제하시겠습니까?" : "이 거래를 삭제하시겠습니까?" } } do %>
          <%= lucide_icon("trash-2", size: 12) %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
