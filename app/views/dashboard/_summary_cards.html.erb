<%# 카드 높이 grid로 강제 통일 %>
<div class="grid grid-cols-3 gap-3" style="grid-auto-rows: 1fr;">
  <%# 수입 카드 %>
  <div class="stat-card flex flex-col">
    <p class="stat-card-label">수입</p>
    <p class="stat-card-value font-tabular" style="color: var(--color-income);">
      <%= format_currency(total_income) %>
    </p>
  </div>

  <%# 지출 카드 %>
  <div class="stat-card flex flex-col">
    <p class="stat-card-label">지출</p>
    <p class="stat-card-value font-tabular" style="color: var(--color-expense);">
      <%= format_currency(total_expense) %>
    </p>
  </div>

  <%# 총자산 카드 %>
  <div class="stat-card flex flex-col" data-controller="toggle" data-toggle-mode-value="visibility">
    <p class="stat-card-label">총자산</p>
    <p class="stat-card-value font-tabular" data-toggle-target="content" style="color: var(--color-assets);">
      <%= format_currency(total_assets) %>
    </p>
    <div class="mt-auto pt-1">
      <button data-action="toggle#toggle"
              class="text-[10px] font-medium"
              style="color: var(--color-text-muted);">
        표시/숨김
      </button>
    </div>
  </div>
</div>
