<% selected_date ||= Date.today %>
<% taggings_by_date ||= {} %>
<div class="card p-4"
     data-controller="calendar"
     data-calendar-selected-date-value="<%= selected_date.strftime('%Y-%m-%d') %>">

  <%# 월 네비게이션 %>
  <div class="flex items-center justify-between mb-4">
    <%= link_to dashboard_index_path(date: date.prev_month.strftime("%Y-%m-%d")),
        class: "btn-ghost p-2 rounded-lg",
        aria_label: "이전 달",
        data: { turbo_frame: "month_frame" } do %>
      <i data-lucide="chevron-left" aria-hidden="true" class="lucide-icon" style="width: 18px; height: 18px;"></i>
    <% end %>

    <span class="text-base font-bold">
      <%= l(date, format: "%Y년 %m월") %>
    </span>

    <%= link_to dashboard_index_path(date: date.next_month.strftime("%Y-%m-%d")),
        class: "btn-ghost p-2 rounded-lg",
        aria_label: "다음 달",
        data: { turbo_frame: "month_frame" } do %>
      <i data-lucide="chevron-right" aria-hidden="true" class="lucide-icon" style="width: 18px; height: 18px;"></i>
    <% end %>
  </div>

  <%# 요일 헤더 %>
  <div class="grid grid-cols-7 text-center text-xs font-medium mb-2" style="color: var(--color-text-muted);">
    <% %w[일 월 화 수 목 금 토].each do |day_name| %>
      <div class="py-1"><%= day_name %></div>
    <% end %>
  </div>

  <%# 달력 그리드 %>
  <% start_date = date.beginning_of_month.beginning_of_week(:sunday) %>
  <% end_date = date.end_of_month.end_of_week(:sunday) %>
  <div class="grid grid-cols-7 gap-0.5 sm:gap-1">
    <% (start_date..end_date).each do |day| %>
      <% day_transactions = transactions_by_date[day] || [] %>
      <% day_income = day_transactions.select { |t| t.transaction_type == "income" }.sum(&:amount) %>
      <% day_expense = day_transactions.select { |t| t.transaction_type == "expense" }.sum(&:amount) %>
      <% day_taggings = taggings_by_date[day] || [] %>
      <% unique_tags = day_taggings.map(&:tag).uniq(&:id) %>
      <% is_current_month = day.month == date.month %>
      <% is_today = day == Date.today %>

      <%= link_to dashboard_daily_transactions_path(date: day.strftime("%Y-%m-%d")),
          class: "calendar-day relative p-0.5 sm:p-1 text-center min-h-[52px] sm:min-h-[60px] #{is_today ? 'ring-1 ring-offset-1' : ''}",
          style: "background-color: #{is_today ? 'var(--color-bg-tertiary)' : 'transparent'}; opacity: #{is_current_month ? '1' : '0.3'}; #{'ring-color: var(--color-accent);' if is_today}",
          aria_label: "#{day.month}월 #{day.day}일 거래 보기",
          data: { turbo_frame: "daily_transactions", calendar_target: "day", action: "click->calendar#select", date: day.strftime("%Y-%m-%d"), calendar_today: is_today ? "" : nil } do %>
        <div class="text-xs font-medium"><%= day.day %></div>
        <% if day_income > 0 %>
          <div class="calendar-amount font-tabular" style="color: var(--color-income);">+<%= number_with_delimiter(day_income) %></div>
        <% end %>
        <% if day_expense > 0 %>
          <div class="calendar-amount font-tabular" style="color: var(--color-expense);">-<%= number_with_delimiter(day_expense) %></div>
        <% end %>
        <% if unique_tags.any? %>
          <div class="calendar-tag-dots-right">
            <% unique_tags.first(3).each do |tag| %>
              <span class="calendar-tag-dot" style="background-color: <%= tag.color %>;" title="<%= tag.name %>"></span>
            <% end %>
            <% if unique_tags.size > 3 %>
              <span class="text-[5px] sm:text-[6px] leading-none" style="color: var(--color-text-muted);">+<%= unique_tags.size - 3 %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
