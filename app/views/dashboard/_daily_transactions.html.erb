<%# 높이 100% = 부모(absolute 컨테이너)의 높이 = 왼쪽 컬럼 높이 %>
<% daily_taggings ||= [] %>
<div class="card flex flex-col h-full">

  <%# 헤더 %>
  <div class="px-4 pt-4 pb-3 flex-shrink-0" style="border-bottom: 1px solid var(--color-border-subtle);">
    <div class="flex items-center justify-between mb-1">
      <h3 class="text-sm font-bold">
        <% if selected_dates.length == 1 %>
          <%= l(selected_dates.first, format: "%m월 %d일") %>
          <span style="color: var(--color-text-muted);">
            (<%= %w[일 월 화 수 목 금 토][selected_dates.first.wday] %>)
          </span>
        <% else %>
          <span><%= selected_dates.length %>일 선택</span>
        <% end %>
      </h3>
    </div>
    <div class="flex items-center gap-3 text-xs font-tabular">
      <% if selection_income > 0 %>
        <span style="color: var(--color-income);">+<%= format_currency(selection_income) %></span>
      <% end %>
      <% if selection_expense > 0 %>
        <span style="color: var(--color-expense);">-<%= format_currency(selection_expense) %></span>
      <% end %>
    </div>
  </div>

  <%# 거래 목록 (내부 스크롤) %>
  <div class="flex-1 overflow-y-auto overscroll-contain min-h-0" id="daily_transactions_list">
    <% if transactions.any? %>
      <% transactions.group_by(&:date).sort_by { |d, _| d }.reverse.each do |date, day_txns| %>
        <% if selected_dates.length > 1 %>
          <div class="px-4 pt-3 pb-1">
            <span class="text-[10px] font-medium" style="color: var(--color-text-muted);">
              <%= l(date, format: "%m/%d") %> (<%= %w[일 월 화 수 목 금 토][date.wday] %>)
            </span>
          </div>
        <% end %>
        <% day_txns.each do |transaction| %>
          <%= render "transactions/transaction", transaction: transaction %>
        <% end %>
      <% end %>
    <% else %>
      <%= render "shared/empty_state", message: "거래가 없습니다" %>
    <% end %>

    <%# 독립 태그 기록 (standalone taggings) %>
    <% standalone_taggings = daily_taggings.select { |t| t.transaction_id.nil? } %>
    <% if standalone_taggings.any? %>
      <div class="px-4 pt-3 pb-1" style="border-top: 1px solid var(--color-border-subtle);">
        <span class="text-[10px] font-medium flex items-center gap-1" style="color: var(--color-text-muted);">
          <%= lucide_icon("tag", size: 10) %> 태그 기록
        </span>
      </div>
      <% standalone_taggings.each do |tagging| %>
        <%= render "taggings/tagging", tagging: tagging %>
      <% end %>
    <% end %>
  </div>

  <%# 태그 추가 버튼 %>
  <% if selected_dates.length == 1 %>
    <div class="px-4 py-2 flex-shrink-0" style="border-top: 1px solid var(--color-border-subtle);">
      <%= link_to new_tagging_path(date: selected_dates.first),
          class: "flex items-center justify-center gap-1.5 w-full py-1.5 rounded-lg text-xs font-medium transition-colors hover:bg-[var(--color-bg-tertiary)]",
          style: "color: var(--color-text-muted);",
          data: { turbo_frame: "modal" } do %>
        <%= lucide_icon("tag", size: 12) %>
        <span>태그 추가</span>
      <% end %>
    </div>
  <% end %>
</div>
