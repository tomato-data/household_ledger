<div class="py-4">

  <turbo-frame id="month_frame">
    <%# 왼쪽(카드+달력)이 높이 기준, 오른쪽은 그 안에서 absolute로 맞춤 %>
    <div class="relative">

      <%# === 왼쪽: 카드 + 달력 (높이 기준) === %>
      <div class="lg:pr-[340px]">
        <div class="space-y-4" data-dashboard-layout-target="left">
          <%= render "dashboard/summary_cards",
              total_income: @total_income || 0,
              total_expense: @total_expense || 0,
              total_assets: @total_assets || 0 %>

          <%= render "dashboard/calendar",
              date: @date || Date.today,
              transactions_by_date: @transactions_by_date || {} %>
        </div>
      </div>

      <%# === 오른쪽: 상세 내역 (absolute로 왼쪽 높이에 정확히 맞춤) === %>
      <div class="hidden lg:block absolute top-0 right-0 w-[320px] h-full">
        <turbo-frame id="daily_transactions" class="block h-full">
          <%= render "dashboard/daily_transactions",
              selected_dates: @selected_dates || [Date.today],
              transactions: @daily_transactions || [],
              selection_income: @selection_income || 0,
              selection_expense: @selection_expense || 0 %>
        </turbo-frame>
      </div>

      <%# 모바일에서는 아래에 표시 %>
      <div class="lg:hidden mt-4">
        <turbo-frame id="daily_transactions_mobile">
          <%= render "dashboard/daily_transactions",
              selected_dates: @selected_dates || [Date.today],
              transactions: @daily_transactions || [],
              selection_income: @selection_income || 0,
              selection_expense: @selection_expense || 0 %>
        </turbo-frame>
      </div>

    </div>
  </turbo-frame>

  <div class="mt-5">
    <turbo-frame id="selection_stats">
      <%= render "dashboard/selection_stats",
          stats: @selection_stats || [],
          total: @selection_total || 0,
          selected_dates: @selected_dates || [Date.today] %>
    </turbo-frame>
  </div>

</div>
