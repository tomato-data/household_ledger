<div data-controller="modal"
     class="fixed inset-0 z-50 flex items-center justify-center p-4"
     style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(4px);">
  <div data-modal-target="content"
       class="card-elevated w-full max-w-md max-h-[90vh] overflow-y-auto p-6">
    <h2 class="text-xl font-bold mb-2">환영합니다!</h2>
    <p class="text-sm mb-4" style="color: var(--color-text-secondary);">
      기본 카테고리가 자동으로 생성되었습니다. 카테고리를 자유롭게 수정하세요.
    </p>

    <div class="space-y-1.5 mb-6">
      <% current_user.categories.each do |category| %>
        <div class="flex items-center gap-2.5 px-3 py-2 rounded-lg"
             style="background-color: var(--color-bg-tertiary);">
          <div class="w-7 h-7 rounded-md flex items-center justify-center"
               style="background-color: <%= category.color || '#a3a3a3' %>20; color: <%= category.color || '#a3a3a3' %>;">
            <%= lucide_icon(category.icon, size: 16) %>
          </div>
          <span class="text-sm font-medium"><%= category.name %></span>
        </div>
      <% end %>
    </div>

    <div class="flex gap-3">
      <button data-action="modal#close" class="btn btn-ghost flex-1 py-2.5">
        건너뛰기
      </button>
      <%= link_to "카테고리 관리", categories_path, class: "btn btn-primary flex-1 py-2.5 text-center font-bold" %>
    </div>
  </div>
</div>
