<%= form_with(model: asset_adjustment, data: { controller: "amount-input" }) do |f| %>

  <% if asset_adjustment.errors.any? %>
    <div class="mb-4 p-3 rounded-lg text-sm" style="background-color: var(--color-expense-bg); color: var(--color-danger);">
      <% asset_adjustment.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <%# 보정 타입 %>
  <div class="flex gap-2 mb-4">
    <label class="flex-1">
      <input type="radio" name="asset_adjustment[adjustment_type]" value="income_missing"
             <%= "checked" if asset_adjustment.adjustment_type == "income_missing" || asset_adjustment.new_record? %>
             class="hidden peer">
      <div class="text-center py-2 rounded-lg cursor-pointer text-sm font-medium transition-all peer-checked:font-bold"
           style="border: 1px solid var(--color-border);">
        누락 수입
      </div>
    </label>
    <label class="flex-1">
      <input type="radio" name="asset_adjustment[adjustment_type]" value="expense_missing"
             <%= "checked" if asset_adjustment.adjustment_type == "expense_missing" %>
             class="hidden peer">
      <div class="text-center py-2 rounded-lg cursor-pointer text-sm font-medium transition-all peer-checked:font-bold"
           style="border: 1px solid var(--color-border);">
        누락 지출
      </div>
    </label>
  </div>

  <%# 금액 %>
  <div class="mb-4">
    <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">금액</label>
    <div class="flex items-center gap-2">
      <input type="text"
             data-amount-input-target="display"
             data-action="input->amount-input#format"
             value="<%= number_with_delimiter(asset_adjustment.amount) if asset_adjustment.amount %>"
             placeholder="0"
             class="input flex-1 text-right font-tabular"
             inputmode="numeric">
      <span class="text-sm font-medium" style="color: var(--color-text-muted);">원</span>
    </div>
    <%= f.hidden_field :amount, data: { amount_input_target: "value" } %>
  </div>

  <%# 설명 %>
  <div class="mb-4">
    <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">설명</label>
    <%= f.text_field :description, class: "input", placeholder: "보정 사유" %>
  </div>

  <%# 날짜 %>
  <div class="mb-4">
    <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">날짜</label>
    <%= f.date_field :adjustment_date, value: asset_adjustment.adjustment_date || Date.today, class: "input" %>
  </div>

  <%= f.submit asset_adjustment.persisted? ? "수정" : "추가", class: "btn btn-primary w-full py-2.5" %>
<% end %>
