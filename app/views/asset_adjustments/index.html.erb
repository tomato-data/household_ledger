<div class="space-y-6 py-4">
  <h1 class="text-xl font-bold">자산 보정</h1>

  <%# 새 보정 폼 %>
  <div class="card p-4">
    <h2 class="text-xs font-medium mb-3" style="color: var(--color-text-muted);">새 보정 추가</h2>
    <%= render "asset_adjustments/form", asset_adjustment: AssetAdjustment.new %>
  </div>

  <%# 보정 목록 %>
  <div class="space-y-3" id="asset_adjustments_list">
    <% @asset_adjustments.each do |adjustment| %>
      <%= render "asset_adjustments/asset_adjustment", asset_adjustment: adjustment %>
    <% end %>

    <% if @asset_adjustments.empty? %>
      <%= render "shared/empty_state", message: "자산 보정 기록이 없습니다" %>
    <% end %>
  </div>
</div>
