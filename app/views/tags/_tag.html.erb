<div class="table-row" id="<%= dom_id(tag) %>">
  <%# 색깔 점 + 아이콘 + 이름 %>
  <div class="flex items-center gap-2.5 flex-1 min-w-0">
    <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color: <%= tag.color %>;"></span>
    <% if tag.icon.present? %>
      <%= lucide_icon(tag.icon, size: 14, style: "color: #{tag.color};") %>
    <% end %>
    <span class="text-sm font-medium truncate"><%= tag.name %></span>
  </div>

  <%# 경과일 뱃지 %>
  <div class="flex items-center gap-2 flex-shrink-0">
    <% if last_date %>
      <% days = (Date.today - last_date).to_i %>
      <span class="days-since-badge">
        <% if days == 0 %>
          오늘
        <% else %>
          <%= days %>일 전
        <% end %>
      </span>
      <span class="text-[10px]" style="color: var(--color-text-muted);">
        <%= l(last_date, format: "%m/%d") %>
      </span>
    <% else %>
      <span class="text-[10px]" style="color: var(--color-text-muted);">기록 없음</span>
    <% end %>

    <%# 빠른 기록 버튼 %>
    <%= button_to taggings_path, method: :post,
        class: "btn-ghost p-1 rounded-md opacity-60 hover:opacity-100",
        aria_label: "오늘 기록",
        params: { tagging: { tag_id: tag.id, date: Date.today } } do %>
      <%= lucide_icon("plus-circle", size: 14) %>
    <% end %>

    <%# 수정 %>
    <%= link_to edit_tag_path(tag), class: "btn-ghost p-1 rounded-md opacity-40 hover:opacity-100",
        data: { turbo_frame: "modal" }, aria_label: "수정" do %>
      <%= lucide_icon("pencil", size: 12) %>
    <% end %>

    <%# 삭제 %>
    <%= button_to tag_path(tag), method: :delete,
        class: "btn-ghost p-1 rounded-md opacity-40 hover:opacity-100 cursor-pointer",
        style: "color: var(--color-danger);",
        aria_label: "삭제",
        form: { data: { turbo_confirm: "'#{tag.name}' 태그를 삭제하시겠습니까? 모든 기록도 삭제됩니다." } } do %>
      <%= lucide_icon("trash-2", size: 12) %>
    <% end %>
  </div>
</div>
