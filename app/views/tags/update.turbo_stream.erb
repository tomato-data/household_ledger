<%= turbo_stream.replace "tags_list" do %>
  <div class="card" id="tags_list">
    <% if @tags.any? %>
      <% @tags.each do |tag| %>
        <%= render "tags/tag", tag: tag, last_date: @last_dates[tag.id] %>
      <% end %>
    <% else %>
      <div class="px-4 py-6 text-center text-sm" style="color: var(--color-text-muted);">태그가 없습니다</div>
    <% end %>
  </div>
<% end %>

<%= turbo_stream.replace "modal" do %>
  <turbo-frame id="modal"></turbo-frame>
<% end %>

<%= turbo_stream.append "toast-container" do %>
  <script>showToast("태그가 수정되었습니다")</script>
<% end %>
