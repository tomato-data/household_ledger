<div class="flex items-center justify-center min-h-[80vh]">
  <div class="card-elevated w-full max-w-sm p-6">

    <h2 class="text-xl font-bold text-center mb-6">로그인</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="mb-4">
        <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">이메일</label>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "input",
            placeholder: "email@example.com" %>
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">비밀번호</label>
        <%= f.password_field :password,
            autocomplete: "current-password",
            class: "input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :remember_me, class: "rounded" %>
            <span class="text-sm" style="color: var(--color-text-secondary);">로그인 상태 유지</span>
          </label>
        </div>
      <% end %>

      <%= f.submit "로그인", class: "btn btn-primary w-full py-2.5 font-bold mb-4" %>
    <% end %>

    <div class="text-center text-sm" style="color: var(--color-text-muted);">
      <%= link_to "회원가입", new_registration_path(resource_name), class: "hover:underline", style: "color: var(--color-accent);" %>
    </div>
  </div>
</div>
