<div class="flex items-center justify-center min-h-[80vh]">
  <div class="w-full max-w-sm rounded-xl p-6"
       style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">

    <h2 class="text-xl font-bold text-center mb-6">로그인</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="mb-4">
        <label class="block text-sm mb-1" style="color: var(--color-text-secondary);">이메일</label>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "w-full px-3 py-2 rounded-lg",
            style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); color: var(--color-text-primary);",
            placeholder: "email@example.com" %>
      </div>

      <div class="mb-4">
        <label class="block text-sm mb-1" style="color: var(--color-text-secondary);">비밀번호</label>
        <%= f.password_field :password,
            autocomplete: "current-password",
            class: "w-full px-3 py-2 rounded-lg",
            style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); color: var(--color-text-primary);" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :remember_me, class: "rounded" %>
            <span class="text-sm" style="color: var(--color-text-secondary);">로그인 상태 유지</span>
          </label>
        </div>
      <% end %>

      <%= f.submit "로그인",
          class: "w-full py-2 rounded-lg font-bold cursor-pointer transition-colors mb-4",
          style: "background-color: var(--color-accent); color: var(--color-text-primary);" %>
    <% end %>

    <div class="text-center text-sm" style="color: var(--color-text-muted);">
      <%= link_to "회원가입", new_registration_path(resource_name), class: "hover:underline", style: "color: var(--color-accent);" %>
    </div>
  </div>
</div>
