<div class="flex items-center justify-center min-h-[80vh]">
  <div class="w-full max-w-sm rounded-xl p-6"
       style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border);">

    <h2 class="text-xl font-bold text-center mb-6">회원가입</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <label class="block text-sm mb-1" style="color: var(--color-text-secondary);">이메일</label>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "w-full px-3 py-2 rounded-lg",
            style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); color: var(--color-text-primary);",
            placeholder: "email@example.com" %>
      </div>

      <div class="mb-4">
        <label class="block text-sm mb-1" style="color: var(--color-text-secondary);">비밀번호</label>
        <%= f.password_field :password,
            autocomplete: "new-password",
            class: "w-full px-3 py-2 rounded-lg",
            style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); color: var(--color-text-primary);" %>
        <p class="text-xs mt-1" style="color: var(--color-text-muted);">
          최소 <%= @minimum_password_length %>자 이상
        </p>
      </div>

      <div class="mb-6">
        <label class="block text-sm mb-1" style="color: var(--color-text-secondary);">비밀번호 확인</label>
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "w-full px-3 py-2 rounded-lg",
            style: "background-color: var(--color-bg-tertiary); border: 1px solid var(--color-border); color: var(--color-text-primary);" %>
      </div>

      <%= f.submit "회원가입",
          class: "w-full py-2 rounded-lg font-bold cursor-pointer transition-colors mb-4",
          style: "background-color: var(--color-accent); color: var(--color-text-primary);" %>
    <% end %>

    <div class="text-center text-sm" style="color: var(--color-text-muted);">
      이미 계정이 있으신가요?
      <%= link_to "로그인", new_session_path(resource_name), class: "hover:underline", style: "color: var(--color-accent);" %>
    </div>
  </div>
</div>
