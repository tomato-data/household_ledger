<div class="flex items-center justify-center min-h-[80vh]">
  <div class="card-elevated w-full max-w-sm p-6">

    <h2 class="text-xl font-bold text-center mb-6">회원가입</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-4">
        <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">이메일</label>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "input",
            placeholder: "email@example.com" %>
      </div>

      <div class="mb-4">
        <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">비밀번호</label>
        <%= f.password_field :password,
            autocomplete: "new-password",
            class: "input" %>
        <p class="text-xs mt-1" style="color: var(--color-text-muted);">
          최소 <%= @minimum_password_length %>자 이상
        </p>
      </div>

      <div class="mb-6">
        <label class="block text-xs font-medium mb-1.5" style="color: var(--color-text-muted);">비밀번호 확인</label>
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "input" %>
      </div>

      <%= f.submit "회원가입", class: "btn btn-primary w-full py-2.5 font-bold mb-4" %>
    <% end %>

    <div class="text-center text-sm" style="color: var(--color-text-muted);">
      이미 계정이 있으신가요?
      <%= link_to "로그인", new_session_path(resource_name), class: "hover:underline", style: "color: var(--color-accent);" %>
    </div>
  </div>
</div>
